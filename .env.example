# Copy to .env and fill in.

# LLM backend for history generation + answer synthesis:
#   "cli" (default) — uses the authenticated `claude -p` command; NO API key needed.
#   "sdk"           — uses the anthropic SDK; requires ANTHROPIC_API_KEY below.
TLI_LLM_BACKEND=cli

# Only required when TLI_LLM_BACKEND=sdk.
# ANTHROPIC_API_KEY=sk-ant-...

# Where the Jekyll book-review repo lives (relative paths are resolved from repo root).
TLI_BOOKS_REPO=../travel-in-books.github.io

# Embedding backend: "local" (default, offline, no key) or "voyage".
TLI_EMBED_BACKEND=local
# Only needed when TLI_EMBED_BACKEND=voyage
# VOYAGE_API_KEY=pa-...

# Model overrides (optional — sensible defaults baked in).
# TLI_SYNTH_MODEL=claude-opus-4-8
# TLI_HISTORY_MODEL=claude-haiku-4-5
